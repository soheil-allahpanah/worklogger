DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/worklog

# API (optional)
# HOST=127.0.0.1
# PORT=3000

# Admin CLI (required when running worklogger-admin)
# WORKLOGGER_ADMIN_TOKEN=your-admin-secret

# TUI (required when running the TUI — API must be running)
WORKLOGGER_BASE_URL=http://127.0.0.1:3000
WORKLOGGER_TOKEN=wl_your_device_token

# TUI Excel export directory (optional, default: ~/Download)
# WORKLOGGER_EXPORT_DIR=~/Download
